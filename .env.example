# Required only when fetching live/historical FortyGuard data
FORTYGUARD_API_KEY=

# Optional LLM explanation layer. The deterministic agent works without this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Safety: keep false in public deployments unless you intentionally want API refreshes.
ALLOW_LIVE_REFRESH=false

# The app automatically prefers data/live/snapshot.json when it exists.
THERMOCHARGE_DATA_MODE=auto
